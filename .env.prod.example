# ============================================================
# Runtime env for the EC2 Docker deploy (docker-compose.prod.yml).
#
# Copy to .env.prod ON THE SERVER and fill in real values:
#   cp .env.prod.example .env.prod && nano .env.prod
#
# Only RUNTIME values go here. The NEXT_PUBLIC_* vars are already
# baked into the Docker image at build time and must NOT be set here
# (setting them has no effect on the client bundle).
# ============================================================

# --- Required server secrets ---------------------------------

# Supabase service-role key (Project Settings -> API). Bypasses RLS;
# used only server-side (webhook, automation engine, API-key auth).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption key — 64 hex chars (32 bytes, AES-256-GCM).
# MUST match the key the stored tokens were encrypted with. Do NOT
# rotate after tokens are saved, or every connection breaks.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key

# Meta App Secret (Meta for Developers -> App Settings -> Basic).
# Verifies the HMAC signature on inbound webhook POSTs. Comma-separate
# for multiple Meta apps.
META_APP_SECRET=your-meta-app-secret

# --- Recommended ---------------------------------------------

# Canonical public URL (scheme + host, no trailing slash). Used for
# links generated by cron/background work where there is no request to
# derive the origin from.
NEXT_PUBLIC_SITE_URL=https://opencrm.love

# --- Optional ------------------------------------------------

# Shared secret for the automation/flow cron endpoints. Required only
# if you use automation Wait steps or flows (both 503 until set).
#   openssl rand -hex 32
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID — needed only for image-header template uploads.
# META_APP_ID=your-meta-app-id

# --- Compose host wiring (not read by the app) ---------------

# Where to publish the container port on the host. Behind a reverse
# proxy, set HOST_BIND=127.0.0.1 so the app is only reachable via the
# proxy. For a direct test, leave as 0.0.0.0.
# HOST_BIND=127.0.0.1
# HOST_PORT=3000
